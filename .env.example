# Скопируйте в .env и при необходимости поправьте значения.

# Адрес backend в dev-режиме (используется, когда MODE !== production)
VITE_DEV_SERVER_PATH=http://localhost:3500

# Префикс API в production (относительно домена)
VITE_SERVER_PATH=/maturity-level-backend

# Базовый путь приложения в production.
# Должен совпадать с base в vite.config.ts и с basename роутера в src/router/RoutesList.tsx
VITE_PRODUCT_PATH=/maturity-level
